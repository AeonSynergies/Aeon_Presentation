// Aeon Presentation Platform — Phase 1 schema.
// decks.config and meetings.* mirror the prototype's nested deck-config / session-state
// shapes (see packages/types) so migrating existing data is a data copy, not a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_EXECUTIVE
  OPERATIONS_MANAGER
  BD_MANAGER
  ADMIN
}

// A password reset link and a new-account invitation are the same primitive with
// different triggers — one single-use, expiring token type, distinguished only by
// `purpose` (which changes the email copy, not the redemption mechanics).
enum PasswordSetTokenPurpose {
  RESET
  INVITE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // Job title (e.g. "Account Executive") — shown in the signature of a Minutes of Meeting
  // email (meeting.sendMinutes), nowhere else. Self-service via user.updateProfile, same as
  // name/email; optional since it has no bearing on permissions or login.
  title        String?
  // Role enforcement is a later phase (CLAUDE.md Build Order #9) — this column exists now
  // so it doesn't need a migration later, but no permission checks read it yet.
  role         Role     @default(SALES_EXECUTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set by "Deactivate" on Team Management (soft-delete) — same semantics as
  // Deck.archivedAt/Meeting.archivedAt: the row (and every Meeting they created) stays
  // intact, but a deactivated user can no longer authenticate (password or Microsoft) and
  // is treated as having no role/permissions by every gated procedure. Null means active;
  // this is never set back to null except by an explicit "Reactivate". Unlike deck/meeting
  // archival there is no permanent-delete path once this is set — "Remove" (hard delete) is
  // a separate, narrower action that already refuses to run if the user has any Meeting
  // rows, and deactivation is the real answer for that case rather than a way around it.
  deactivatedAt DateTime?

  refreshTokens         RefreshToken[]
  passwordSetTokens     PasswordSetToken[]
  meetings              Meeting[]
  aiDraftRequests       AiDraftRequest[]
  sessionCollaborations SessionCollaborator[] @relation("SessionCollaboratorUser")
  sentSessionInvites    SessionCollaborator[] @relation("SessionCollaboratorInvitedBy")
  notifications         Notification[]

  @@index([deactivatedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Single-use, expiring token backing both "Forgot password" and "New user invitation" —
// same model, same redemption mechanics (see auth.setPasswordWithToken); only `purpose`
// differs, and only to pick the right email copy when the token is issued. Like
// RefreshToken, only the SHA-256 hash is ever persisted — the raw token exists solely in
// the emailed link, so a DB leak can't be used to set anyone's password.
model PasswordSetToken {
  id        String                  @id @default(cuid())
  tokenHash String                  @unique
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   PasswordSetTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  @@index([userId])
  @@map("password_set_tokens")
}

model Deck {
  id          String   @id @default(cuid())
  slug        String   @unique
  companyName String
  industry    String
  // Full DeckConfig (packages/types DeckConfig) — services, pricing bands, discovery
  // questions, static slide content, team, colors/logo. JSON so deck data migration is
  // close to a data copy from the prototype rather than a schema redesign.
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Set by "Remove" on Home (soft-delete) — excludes the deck from deck.list/getBySlug
  // but keeps the row (and every Meeting referencing it) intact for Archived Files to
  // restore. Null means active/visible; this is never set back to null except by an
  // explicit restore. A real hard delete (Archived Files' "Delete Permanently", Admin-only)
  // is the only path that actually removes the row.
  archivedAt DateTime?

  meetings Meeting[]

  @@index([archivedAt])
  @@map("decks")
}

model Meeting {
  id          String @id @default(cuid())
  deckId      String
  deck        Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  clientName String?

  // Live discovery-call session state (packages/types SessionState), kept in sync with
  // the Discovery Notes panel in real time. Every pricing-driver value (one per model in
  // the deck's pricing-model library) lives in `answers`, keyed by model id — there is no
  // separate deck-level default column.
  selected Json @default("[]")
  toggles  Json @default("{}")
  answers  Json @default("{}")
  discount Json @default("{\"enabled\":false,\"scope\":\"all\",\"services\":[],\"type\":\"percent\",\"value\":0}")

  meetingOutcome Json?

  // Set only when a Discovery Notes session is explicitly saved as a Meeting Record
  // (meeting.complete, Phase 5a) — the pricing computed from that moment's driver/services/
  // discount, frozen at save time. Meeting Records reads/exports/regenerates a PDF from
  // THIS, never by recomputing from the deck's current (possibly since-edited) config, so
  // a historical record's quoted numbers never silently drift with later deck edits.
  pricingSnapshot Json?

  // Set at the same time and by the same meeting.complete call as pricingSnapshot, for the
  // same reason: a frozen copy of that moment's visible Discovery Notes questions/answers
  // (general + service-mapped, grouped exactly like the live panel), so the Word export
  // built from it can never drift if the live session's answers keep changing after the
  // record was saved, or if the deck's discovery questions are edited later.
  discoverySnapshot Json?

  // Set at the same time as pricingSnapshot, by the same meeting.complete call — the
  // definitive "this session was saved as a Meeting Record" marker. A plain DateTime null
  // check (completedAt: { not: null }) is what Meeting Records' list query filters on,
  // rather than inspecting meetingOutcome/pricingSnapshot's JSON-vs-SQL-null semantics —
  // every live session still creates a Meeting row via meeting.create, but only ones an
  // eligible role explicitly completed should ever show up as a record.
  completedAt DateTime?

  // Set by "Delete" on Meeting Records (soft-delete) — excludes the record from
  // meeting.listRecords but keeps the row for Archived Files to restore. Same semantics
  // as Deck.archivedAt above; only Archived Files' permanent-delete path actually removes
  // the row.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-field "someone is actively editing this" locks for multi-user collaboration (see
  // SessionCollaborator below) — a map of fieldKey -> {userId, userName, lockedAt}. Staleness
  // (no typing activity for ~15-30s) is checked at read time in meeting.get rather than via
  // a background job, since the existing 1.5s poll already re-reads this row on every
  // client; a lock also naturally disappears if the browser that set it crashes or closes,
  // since nothing keeps refreshing lockedAt for it.
  fieldLocks Json @default("{}")

  collaborators SessionCollaborator[]

  @@index([deckId])
  @@index([createdById])
  @@index([completedAt])
  @@index([archivedAt])
  @@map("meetings")
}

// Who currently has access to a Meeting's live Discovery Notes session, replacing the old
// "only createdById can read/write this Meeting" check (see meeting.get/updateState) with
// real per-session collaborators. The Meeting's own createdById is kept purely as
// historical/audit metadata from here on — it is NOT re-checked for access once this table
// exists; meeting.create inserts the creator's own row here (isOwner: true) in the same
// transaction, so this table is always the single source of truth for who can open a
// session, from the very first person.
//
// Exactly one collaborator per meeting may have isOwner: true — enforced by a partial
// unique index added by raw SQL in this model's migration (Prisma's schema DSL has no
// partial-unique-index syntax), not just trusted at the application layer.
model SessionCollaborator {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("SessionCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  isOwner     Boolean  @default(false)
  invitedById String?
  invitedBy   User?    @relation("SessionCollaboratorInvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@map("session_collaborators")
}

// Generic in-app notification, first (and so far only) use: a session-invite ping. Kept
// deliberately untyped beyond title/body/linkUrl rather than adding a "kind" enum for a
// single kind — extend with a type discriminator only once a second kind actually exists.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// One row per AI drafting call (Phase 3a) — never the draft content itself, just who
// asked and when. This is the rate-limit ledger: ai.draftDeck counts rows in the recent
// window before it ever calls Anthropic, so the guardrail survives a server restart and
// is shared across every App Runner instance, unlike an in-memory counter.
model AiDraftRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_draft_requests")
}
