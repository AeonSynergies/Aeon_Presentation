{
  "name": "@aeon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:with-migrate": "pnpm --filter @aeon/database migrate && pnpm --filter @aeon/database seed && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aeon/database": "workspace:*",
    "@aeon/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.121.0",
    "@azure/msal-node": "^2.16.2",
    "@trpc/server": "^11.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.4",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
